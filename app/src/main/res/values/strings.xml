    <string name="dialog_download_title">需要下載運行時</string>
    <string name="dialog_download_message">首次執行 Windows .exe 需下載 Wine／glibc rootfs／Box64 等組件（%1$s，可斷點續傳）。建議在 Wi‑Fi 下進行。是否繼續？</string>
    <string name="dialog_download_confirm">開始下載</string>
    <string name="dialog_cancel">取消</string>

    <string name="dialog_clear_runtime_title">重裝運行時？</string>
    <string name="dialog_clear_runtime_message">將清除本機引擎運行時與下載快取，下次啟動會依目前 App 版本重新下載最新組件集。不會刪除工作區與遊戲存檔（wineprefix）。尚不支援釘選／回退舊 runtime。</string>
    <string name="dialog_clear_runtime_confirm">清除並重裝</string>
    <string name="clear_runtime_done">已清除運行時（約釋放 %1$s）。下次啟動將重新下載。</string>

    <string name="dialog_delete_ws_title">刪除工作區？</string>
    <string name="dialog_delete_ws_message">將移除「%1$s」工作區目錄（含 wineprefix／日誌）。裝置上的原始 .exe 不會被刪。</string>
    <string name="dialog_delete_ws_confirm">刪除</string>

    <string name="dialog_kgsl_title">此裝置可能無畫面</string>
    <string name="dialog_kgsl_message">未偵測到 Adreno／KGSL（/dev/kgsl-3d0）。目前 GPU 路徑依賴 Turnip＋KGSL，Mali／其他 GPU 可能黑屏。仍要繼續嘗試嗎？</string>
    <string name="dialog_kgsl_continue">仍要繼續</string>

    <string name="dialog_about_title">關於 x86-in-android</string>
    <string name="dialog_about_body">版本 %1$s（versionCode %2$d）\n建置 tip：%3$s\n\n僅支援 arm64-v8a、Android 9+（minSdk 28）。\n虛擬桌面固定 1280×720。\nGPU 期望：Qualcomm Adreno／KGSL。\n\n「重裝運行時」會依本版 runtimeId 拉取最新組件；不支援釘選舊 runtime。\n相容說明見 docs/COMPAT.md（GitHub）。</string>
    <string name="dialog_about_ok">知道了</string>

