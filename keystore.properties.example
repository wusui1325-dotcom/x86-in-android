# 複製到本機安全路徑（建議 /workspace/.secrets/x86-in-android/keystore.properties）
# 或專案根目錄 keystore.properties（已被 .gitignore）
# 絕對不要 commit 真實密碼或 .jks / .keystore
#
# 建置時優先讀環境變數：
#   ANDROID_KEYSTORE_PATH / ANDROID_KEYSTORE_PASSWORD / ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD
# 其次讀：
#   1) $X86_KEYSTORE_PROPS（路徑）
#   2) /workspace/.secrets/x86-in-android/keystore.properties
#   3) 專案根 keystore.properties

storeFile=/absolute/path/to/wusper-x86-release.keystore
storePassword=CHANGE_ME
keyAlias=wusper-x86
keyPassword=CHANGE_ME
